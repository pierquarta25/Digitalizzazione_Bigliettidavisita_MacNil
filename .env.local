# Supabase
# Supabase - Ottieni queste chiavi dalla tua dashboard Supabase (Settings -> API)
# URL del progetto (es. https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
# Chiave anonima (es. eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# HubSpot (Riutilizzato dalle logiche precedenti)
HUBSPOT_TOKEN=pat-eu1-metti-il-tuo-token-qui

# OCR & AI (Opzionali per ora)
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=
